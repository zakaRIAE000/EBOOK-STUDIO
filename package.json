{
  "name": "ebook-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ebook refinement factory: Synthesise AI PDF + brand foundation -> premium 6x9 English-US PDF.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "studio:ingest": "tsx src/cli/index.ts ingest",
    "studio:audit": "tsx src/cli/index.ts audit",
    "studio:plan": "tsx src/cli/index.ts plan",
    "studio:design": "tsx src/cli/index.ts design",
    "studio:cover": "tsx src/cli/index.ts cover",
    "studio:bonus": "tsx src/cli/index.ts bonus",
    "studio:prototype": "tsx src/cli/index.ts prototype",
    "studio:build": "tsx src/cli/index.ts build",
    "studio:qc": "tsx src/cli/index.ts qc",
    "studio:all": "tsx src/cli/index.ts all",
    "studio:status": "tsx src/cli/index.ts status",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^12.1.0",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.6.82",
    "playwright": "^1.47.0",
    "sharp": "^0.33.5",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.1": true,
    "sharp@0.33.5": true
  },
  "lavamoat": {
    "allowScripts": {
      "pagedjs>@babel/polyfill>core-js#2.6.12": true,
      "pagedjs>event-emitter>es5-ext#0.10.64": true,
      "sharp#0.33.5": true,
      "tsx>esbuild#0.28.1": true
    }
  }
}
